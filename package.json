{
  "name": "marsh-barbary",
  "version": "1.0.0",
  "description": "Marsh Barbary - Wild Elegance Meets Style",
  "bin": {
    "vite": "./build.js"
  },
  "scripts": {
    "dev": "node build.js",
    "build": "node build.js",
    "preview": "node build.js",
    "vite": "node build.js",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('node_modules/.bin',{recursive:true});try{fs.symlinkSync('../../build.js','node_modules/.bin/vite')}catch(e){fs.copyFileSync('build.js','node_modules/.bin/vite')};try{fs.chmodSync('node_modules/.bin/vite',0o755)}catch(e){}\""
  },
  "devDependencies": {
    "vite": "^5.4.11",
    "puppeteer-core": "^25.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}
